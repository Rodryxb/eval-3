<!DOCTYPE html>
<html lang="es">
<head>
  <meta charset="UTF-8" />
  <title>Nuevo Usuario</title>
  <link rel="stylesheet" href="/css/estilos.css" />
</head>
<body>
  <div class="contenedor">
    <h1>Registrar Usuario</h1>

    <% if (error) { %>
      <div class="error"><%= error %></div>
    <% } %>

    <form action="/usuarios" method="POST">
      <label for="nombre">Nombre completo *</label>
      <input type="text" id="nombre" name="nombre" required />

      <label for="rut">RUT (con dígito verificador) *</label>
      <input type="text" id="rut" name="rut" placeholder="12345678-9" required />

      <label for="correo">Correo electrónico *</label>
      <input type="email" id="correo" name="correo" required />

      <label for="telefono">Teléfono</label>
      <input type="text" id="telefono" name="telefono" />

      <label for="fechaNacimiento">Fecha de nacimiento</label>
      <input type="date" id="fechaNacimiento" name="fechaNacimiento" />

      <label for="nacionalidad">Nacionalidad (ISO-3166 Alpha-2, ej: CL) *</label>
      <input type="text" id="nacionalidad" name="nacionalidad" maxlength="2" placeholder="CL" required />

      <label for="genero">Género</label>
      <select id="genero" name="genero">
        <option value="">-- Seleccione --</option>
        <option value="M">Masculino</option>
        <option value="F">Femenino</option>
        <option value="O">Otro</option>
      </select>

      <fieldset>
        <legend>Dirección *</legend>

        <label for="comuna">Comuna *</label>
        <input type="text" id="comuna" name="comuna" required />

        <label for="calle">Calle *</label>
        <input type="text" id="calle" name="calle" required />

        <label for="numero">Número *</label>
        <input type="text" id="numero" name="numero" required />

        <label for="departamentoOficina">Departamento / Oficina</label>
        <input type="text" id="departamentoOficina" name="departamentoOficina" />
      </fieldset>

      <label for="contrasena">Contraseña *</label>
      <input type="password" id="contrasena" name="contrasena" required />

      <button type="submit">Guardar</button>
    </form>

    <a href="/usuarios">Volver al listado</a>
  </div>
</body>
</html>
